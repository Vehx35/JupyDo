# JupyDo hub image, built ONLY from vendored files: no download during the build.
# They come from jupydo-builder's vendor/hub (scripts/make-vendor-hub.sh), published on
# Zenodo with the rest of the builder. build-hub.sh loads the base image and puts the
# other files in hub-vendor/ (next to this file) before building; GitHub builds it the
# same way (.github/workflows/hub-image.yml). See vendor/hub/*/manifest.txt for versions.
ARG HUB_BASE=jupydo-hub-base:vendored
FROM ${HUB_BASE}

# JupyterHub and its proxy, the Python packages of the services (Genome Index), and the
# sources of the Genome Index Service and of the JupyDo Assistant (at a fixed commit)
COPY hub-vendor/ /tmp/hub-vendor/
RUN python3 -m pip install --no-cache-dir --no-index --find-links /tmp/hub-vendor/wheels \
        -r /tmp/hub-vendor/requirements.txt \
 && tar -xJf /tmp/hub-vendor/node.tar.xz -C /usr/local --strip-components=1 \
        --exclude='*/CHANGELOG.md' --exclude='*/LICENSE' --exclude='*/README.md' \
 && tar -xzf /tmp/hub-vendor/configurable-http-proxy.tar.gz -C /usr/local \
 && configurable-http-proxy --version \
 && mkdir -p /opt/genome-index /opt/assistant \
 && tar -xzf /tmp/hub-vendor/genome-index.tar.gz -C /opt/genome-index --strip-components=1 \
 && tar -xzf /tmp/hub-vendor/assistant.tar.gz -C /opt/assistant --strip-components=1 \
 && mkdir -p /opt/jupydo-vendor && cp /tmp/hub-vendor/manifest*.txt /opt/jupydo-vendor/ \
 && rm -rf /tmp/hub-vendor

# Create the directory for JupyterHub configuration
RUN mkdir -p /etc/jupyterhub

# Copy the JupyterHub configuration file to the created directory
COPY jupyterhub_config.py /etc/jupyterhub/jupyterhub_config.py

# Batch job queue service (outside /etc/jupyterhub, which is a mounted volume)
COPY jobqueue_service.py jobqueue_admin.py jobqueue_admin.html jobqueue_magic.py jobqueue_cli.py ipython_kernel_config.py Rprofile.site /opt/jobqueue/

# Image builder logic: makes every chosen image JupyDo-ready (vendorized stack)
COPY jupydo_builder.py jupydo_ui.py jupydo_environments.py jupydo_environments.html jupydo_notifications.py jupydo_notifications.html jupydo_images_lib.py jupydo_images.py jupydo_images.html jupydo_transfer.py jupydo_transfer.html jupydo_bookings.py jupydo_bookings.html /opt/jupydo/
# Cell log (only used if enabled in first_start.sh)
COPY jupydo_celllog.py jupydo_celllog_server.py jupydo_celllog_config.py /opt/jupydo/
COPY templates/ /opt/jupydo/templates/
COPY jobqueue_example/ /opt/jupydo/jobqueue_example/
COPY apptainer_example/ /opt/jupydo/apptainer_example/
COPY jupydo_selftest/ /opt/jupydo/jupydo_selftest/
COPY labextension/jupydo-notifications/ /opt/jupydo/labextension/jupydo-notifications/

# Set the working directory
WORKDIR /etc/jupyterhub

# The EXPOSE instruction documents the port, but you must publish it when running the container.
# Use: docker run -p 8000:8000
EXPOSE 8000

CMD ["python3", "-m", "jupyterhub", "-f", "/etc/jupyterhub/jupyterhub_config.py"]
