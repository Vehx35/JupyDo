{
  "name": "jupydo-notifications",
  "version": "0.1.0",
  "description": "JupyDo: notifications bar and Hub Control Panel button in JupyterLab",
  "license": "BSD-3-Clause",
  "main": "lib/index.js",
  "files": [
    "lib/"
  ],
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "sharedPackages": {
      "@jupyterlab/coreutils": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": "^6.0.0"
      },
      "@lumino/widgets": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": "^2.0.0"
      },
      "@jupyterlab/apputils": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": "^4.0.0"
      }
    },
    "_build": {
      "load": "static/remoteEntry.b64de90d3e9d8c35cb4c.js",
      "extension": "./extension"
    }
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/coreutils": "^6.0.0",
    "@lumino/widgets": "^2.0.0",
    "@jupyterlab/apputils": "^4.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0"
  }
}
